# ==========================================
# Environment Variables Example
# Copy this file to .env and fill in your keys:
# cp .env.example .env
# ==========================================

# Buffer API Configuration
# Get your API key and IDs from the Buffer Developer Dashboard: https://buffer.com/developers
BUFFER_API_KEY=your_buffer_api_key_here
BUFFER_LINKEDIN_CHANNEL_ID=your_linkedin_channel_id_here
BUFFER_ORG_ID=your_buffer_organization_id_here
